<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-4">
  <div class="col-12 col-lg-8">
    <div class="form-card">
      <h1 class="mb-3">Privacy Policy</h1>
      <p class="text-muted">Effective Date: <%= new Date().getFullYear() %></p>
      <p>Guniva Pvt. Limited respects your privacy. We collect only the information required to create your account, publish property listings, and display reviews.</p>
      <h5 class="mt-4">Information We Collect</h5>
      <p class="text-muted">Account credentials (username, email, securely hashed password), listing details, uploaded property images, and user-submitted reviews.</p>
      <h5 class="mt-4">Third-Party Services</h5>
      <p class="text-muted">We use Cloudinary for image hosting and Mapbox for geocoding and interactive maps.</p>
      <a href="/listings" class="btn btn-guniva mt-3">Back to Listings</a>
    </div>
  </div>
</div>
