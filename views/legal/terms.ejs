<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-4">
  <div class="col-12 col-lg-8">
    <div class="form-card">
      <h1 class="mb-3">Terms of Service</h1>
      <p class="text-muted">Effective Date: <%= new Date().getFullYear() %></p>
      <p>By accessing or using Guniva, you agree to provide accurate listing details, respect other community members, and follow applicable local laws.</p>
      <h5 class="mt-4">Host Responsibilities</h5>
      <p class="text-muted">Hosts are responsible for the accuracy of their property descriptions, pricing, location, and imagery.</p>
      <h5 class="mt-4">Community Reviews</h5>
      <p class="text-muted">Reviews must reflect genuine experiences and remain respectful.</p>
      <a href="/listings" class="btn btn-guniva mt-3">Back to Listings</a>
    </div>
  </div>
</div>
