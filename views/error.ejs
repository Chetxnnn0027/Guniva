<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-5">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="form-card text-center">
      <div class="mb-3" style="font-size: 2.5rem; color: var(--guniva-error);">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <h2 class="mb-2">Oops! Something went wrong</h2>
      <p class="text-muted mb-4"><%= err.message || "An unexpected error occurred." %></p>
      <a href="/listings" class="btn btn-guniva">Back to Explore</a>
    </div>
  </div>
</div>
