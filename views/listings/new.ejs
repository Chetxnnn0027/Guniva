<% layout("/layouts/boilerplate") %>

<%
  const categories = [
    "Trending", "Rooms", "Mountains", "Iconic Cities", "Castles",
    "Amazing Pools", "Camping", "Farms", "Arctic", "Domes"
  ];
%>

<div class="row justify-content-center mt-4">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="form-card">
      <h3>Create a New Listing</h3>
      <p class="text-muted mb-4">Share your space with travelers on Guniva.</p>

      <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            name="listing[title]"
            id="title"
            required
            placeholder="Add a catchy title"
            class="form-control"
          >
          <div class="valid-feedback">Title looks good!</div>
          <div class="invalid-feedback">Please enter a title.</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            name="listing[description]"
            id="description"
            required
            rows="4"
            placeholder="Describe your place, amenities, and surroundings"
            class="form-control"
          ></textarea>
          <div class="invalid-feedback">Please enter a short description.</div>
        </div>

        <div class="row">
          <div class="mb-3 col-12 col-md-6">
            <label for="image" class="form-label">Upload Listing Image</label>
            <input
              type="file"
              name="listing[image]"
              id="image"
              accept="image/*"
              required
              class="form-control"
            >
            <div class="invalid-feedback">Please upload a property image.</div>
          </div>

          <div class="mb-3 col-12 col-md-6">
            <label for="category" class="form-label">Category</label>
            <select name="listing[category]" id="category" class="form-select">
              <option value="">Select a category (optional)</option>
              <% for (const cat of categories) { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="mb-3 col-12 col-md-4">
            <label for="price" class="form-label">Price per night (&#8377;)</label>
            <input
              type="number"
              name="listing[price]"
              id="price"
              min="0"
              required
              placeholder="2500"
              class="form-control"
            >
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>

          <div class="mb-3 col-12 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
              type="text"
              name="listing[country]"
              id="country"
              required
              placeholder="India"
              class="form-control"
            >
            <div class="invalid-feedback">Please enter a valid country.</div>
          </div>
        </div>

        <div class="mb-4">
          <label for="location" class="form-label">Location</label>
          <input
            type="text"
            name="listing[location]"
            id="location"
            required
            placeholder="New Delhi"
            class="form-control"
          >
          <div class="invalid-feedback">Please enter a valid location.</div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-guniva" type="submit">Publish Listing</button>
          <a href="/listings" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
