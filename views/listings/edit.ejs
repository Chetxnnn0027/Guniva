<% layout("/layouts/boilerplate") %>

<%
  const categories = [
    "Trending", "Rooms", "Mountains", "Iconic Cities", "Castles",
    "Amazing Pools", "Camping", "Farms", "Arctic", "Domes"
  ];
%>

<div class="row justify-content-center mt-4">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="form-card">
      <h3>Edit Your Listing</h3>
      <p class="text-muted mb-4">Update details, pricing, or upload a new photo.</p>

      <form method="POST" novalidate class="needs-validation" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input id="title" name="listing[title]" required value="<%= listing.title %>" class="form-control" type="text">
          <div class="invalid-feedback">Please enter a title.</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea id="description" name="listing[description]" required rows="4" class="form-control"><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a short description.</div>
        </div>

        <% if (originalImageUrl) { %>
          <div class="mb-3">
            <label class="form-label d-block">Current Listing Image</label>
            <img src="<%= originalImageUrl %>" alt="<%= listing.title %>" class="edit-preview-img">
          </div>
        <% } %>

        <div class="row">
          <div class="mb-3 col-12 col-md-6">
            <label for="image" class="form-label">Replace Image (optional)</label>
            <input id="image" name="listing[image]" accept="image/*" class="form-control" type="file">
          </div>

          <div class="mb-3 col-12 col-md-6">
            <label for="category" class="form-label">Category</label>
            <select name="listing[category]" id="category" class="form-select">
              <option value="">Select a category (optional)</option>
              <% for (const cat of categories) { %>
                <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="mb-3 col-12 col-md-4">
            <label for="price" class="form-label">Price per night (&#8377;)</label>
            <input id="price" name="listing[price]" min="0" required class="form-control" value="<%= listing.price %>" type="number">
            <div class="invalid-feedback">Price should be valid.</div>
          </div>

          <div class="mb-3 col-12 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input id="country" name="listing[country]" class="form-control" value="<%= listing.country %>" type="text" required>
            <div class="invalid-feedback">Country should be valid.</div>
          </div>
        </div>

        <div class="mb-4">
          <label for="location" class="form-label">Location</label>
          <input id="location" name="listing[location]" class="form-control" value="<%= listing.location %>" type="text" required>
          <div class="invalid-feedback">Location should be valid.</div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-guniva" type="submit">Save Changes</button>
          <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
